{
  "name": "aether-tool",
  "version": "0.1.0",
  "description": "Run JavaScript in an aether-node sandboxed micro-VM over its HTTP RPC — a DSH plugin for the aether-node project.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "aether-node",
    "sandbox"
  ],
  "license": "Apache-2.0",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "./index.js",
    "./vm.js",
    "./config.js",
    "./icon.svg",
    "./locale",
    "cordis.patch.yml",
    "./README.md",
    "./README.en.md",
    "./LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.1 || ^0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "verify": "node verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
