{
  "name": "aether-node",
  "version": "0.1.0",
  "description": "Core engine of a decentralized, local-first AI operating system: CRDT sync engine, sandboxed micro-VM, and a JSON-RPC agent protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "demo": "npm run build && node dist/demo.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=18.19"
  },
  "keywords": [
    "local-first",
    "crdt",
    "sync",
    "sandbox",
    "vm",
    "json-rpc",
    "ai",
    "agent",
    "decentralized"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doujiaozh/aether-node.git"
  },
  "jest": {
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "modules": false,
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "verbose": true
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "typescript": "^5.7.2"
  }
}
